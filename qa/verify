#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

MODE="targeted"
BASE="${CODEX_GAUNTLET_BASE:-}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --mode) MODE="${2:?missing mode}"; shift 2 ;;
    --base) BASE="${2:?missing base}"; shift 2 ;;
    *) echo "Unknown argument: $1" >&2; exit 2 ;;
  esac
done
case "$MODE" in targeted|stop|ci) ;; *) echo "Invalid mode: $MODE" >&2; exit 2 ;; esac

mkdir -p .qa-artifacts
LOG=".qa-artifacts/verify-${MODE}.log"
: > "$LOG"
run() {
  echo "+ $*" | tee -a "$LOG"
  "$@" 2>&1 | tee -a "$LOG"
}

HARNESS_CHECK_ARGS=(--skip-doctor-command)
if [[ "${CODEX_GAUNTLET_CROSS_PLATFORM:-}" == "1" ]]; then
  HARNESS_CHECK_ARGS+=(--skip-binary-execution)
fi
run python3 qa/check_harness.py "${HARNESS_CHECK_ARGS[@]}"
run python3 qa/selftest/run.py --group all
run python3 qa/policy_audit.py

CLASSIFY_ARGS=(--json)
if [[ -n "$BASE" ]]; then
  CLASSIFY_ARGS+=(--base "$BASE")
fi
CLASS_JSON="$(python3 qa/classify_changes.py "${CLASSIFY_ARGS[@]}")"
echo "$CLASS_JSON" | tee -a "$LOG"
mapfile -t CLASSES < <(python3 -c 'import json,sys; print(*json.load(sys.stdin)["classes"], sep="\n")' <<< "$CLASS_JSON")

declare -A GATES=()
for class in "${CLASSES[@]}"; do
  case "$class" in
    docs-only) GATES[docs]=1 ;;
    pure-logic) GATES[unit]=1; GATES[coverage]=1 ;;
    api-contract) GATES[unit]=1; GATES[integration]=1; GATES[acceptance]=1; GATES[coverage]=1 ;;
    migration-schema) GATES[unit]=1; GATES[integration]=1; GATES[migration]=1; GATES[acceptance]=1 ;;
    dependency) GATES[build]=1; GATES[unit]=1; GATES[integration]=1 ;;
    security-critical) GATES[unit]=1; GATES[integration]=1; GATES[coverage]=1; GATES[mutation]=1 ;;
    codex|qa|gauntlet-skill|harness-managed-core|harness-provenance|workflow|agents-entrypoint|unknown-mixed)
      GATES[docs]=1; GATES[build]=1; GATES[unit]=1; GATES[integration]=1; GATES[acceptance]=1; GATES[coverage]=1
      ;;
  esac
done

for gate in docs build unit integration acceptance coverage migration mutation; do
  [[ -n "${GATES[$gate]:-}" ]] || continue
  if [[ "$gate" == docs ]]; then
    run python3 -m compileall -q .codex/hooks qa
  else
    run bash "qa/run-${gate}.sh"
  fi
done

if [[ "$MODE" == ci ]]; then
  run git diff --check
fi

echo "PASS: qa/verify --mode $MODE" | tee -a "$LOG"
