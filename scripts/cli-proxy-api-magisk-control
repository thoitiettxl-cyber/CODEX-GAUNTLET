#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODULE="$ROOT/modules/cli-proxy-api-magisk"
PROVENANCE="$ROOT/docs/provenance/cli-proxy-api-magisk-source.json"

usage() {
  echo "Usage: scripts/termux-control cli-proxy-api-magisk {status|source-check|syntax|test|build}"
  echo "       CPA_RUNTIME_DIR=/reviewed/runtime scripts/termux-control cli-proxy-api-magisk test"
  echo "       CPA_RUNTIME_DIR=/reviewed/runtime scripts/termux-control cli-proxy-api-magisk build"
}

source_check() {
  command -v jq >/dev/null 2>&1 || {
    echo "FAIL: jq is required for source provenance checks." >&2
    exit 1
  }
  local path expected actual expected_mode actual_mode failed=0
  while IFS=$'\t' read -r path expected expected_mode; do
    if [[ ! -f "$ROOT/$path" ]]; then
      echo "FAIL: missing vendored source: $path" >&2
      failed=1
      continue
    fi
    actual="$(sha256sum "$ROOT/$path" | awk '{print $1}')"
    if [[ "$actual" != "$expected" ]]; then
      echo "FAIL: source checksum drift: $path" >&2
      failed=1
    fi
    actual_mode="$(stat -c '%a' "$ROOT/$path")"
    expected_mode="${expected_mode#100}"
    if [[ "$actual_mode" != "$expected_mode" ]]; then
      echo "FAIL: source mode drift: $path ($actual_mode != $expected_mode)" >&2
      failed=1
    fi
  done < <(jq -r '.files[] | [.path, .sha256, .git_mode] | @tsv' "$PROVENANCE")
  [[ "$failed" == 0 ]] || exit 1
  echo "PASS: vendored CLIProxyAPI Magisk source matches pinned provenance"
}

syntax_check() {
  local file
  for file in \
    "$MODULE/customize.sh" \
    "$MODULE/service.sh" \
    "$MODULE/action.sh" \
    "$MODULE/uninstall.sh" \
    "$MODULE/system/bin/cpactl" \
    "$MODULE/scripts/cpactl"; do
    sh -n "$file"
  done
  bash -n "$MODULE/build.sh"
  bash -n "$ROOT/scripts/tests/test-cli-proxy-api-magisk-feasibility.sh"
  bash -n "$ROOT/scripts/tests/test-cli-proxy-api-magisk-module.sh"
  bash -n "$ROOT/scripts/tests/test-cli-proxy-api-magisk-staging-live.sh"
  echo "PASS: CLIProxyAPI Magisk shell syntax"
}

status() {
  local runtime="${CPA_RUNTIME_DIR:-/data/local/cli-proxy-api/current}"
  local command missing=()
  echo "source_root=$MODULE"
  echo "module_version=$(sed -n 's/^version=//p' "$MODULE/module.prop")"
  echo "source_commit=$(jq -r '.source_commit' "$PROVENANCE")"
  echo "runtime_candidate=$runtime"
  if head -c 0 "$runtime/bin/cli-proxy-api" >/dev/null 2>&1; then
    echo "runtime_payload=readable"
  elif [[ -e "$runtime/bin/cli-proxy-api" ]]; then
    echo "runtime_payload=root-restricted"
  else
    echo "runtime_payload=missing"
  fi
  for command in bash busybox file grun jq readelf rg sha256sum unzip zip; do
    command -v "$command" >/dev/null 2>&1 || missing+=("$command")
  done
  if [[ "${#missing[@]}" == 0 ]]; then
    echo "build_toolchain=ready"
  else
    echo "build_toolchain=missing:${missing[*]}"
  fi
  echo "live_control=root-required-via-cpactl"
  echo "verification_authority=./qa/verify"
}

case "${1:-}" in
  status)
    status
    ;;
  source-check)
    source_check
    ;;
  syntax)
    syntax_check
    ;;
  test)
    shift
    [[ "${1:-}" != "--require-live" ]] || {
      echo "FAIL: live root proof requires explicit authorization; use the runbook." >&2
      exit 2
    }
    exec bash "$ROOT/scripts/tests/test-cli-proxy-api-magisk-module.sh" "$@"
    ;;
  build)
    shift
    [[ "$#" == 0 ]] || { usage >&2; exit 2; }
    exec "$MODULE/build.sh"
    ;;
  -h|--help|help|'')
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
