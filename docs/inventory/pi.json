{
  "schema_version": 1,
  "name": "pi",
  "kind": "optional-external-binary",
  "capability": "auxiliary-agent-runtime",
  "responsibility": "Tool access",
  "authority": "auxiliary-only",
  "control_entrypoint": "~/.local/bin/pi",
  "runbook": "docs/runbooks/pi-termux.md",
  "upstream_releases": "https://github.com/earendil-works/pi/releases/latest",
  "materialized_targets": {
    "primary_launcher": "~/.local/bin/pi",
    "recovery_launcher": "~/.local/bin/pi.before-update-core",
    "glibc_runner": "~/.local/bin/pi-glibc-runner",
    "core_updater": "~/.local/bin/pi-core-update",
    "core_rollback": "~/.local/bin/pi-core-rollback",
    "release_root": "~/.local/opt/pi/releases",
    "current": "~/.local/opt/pi/current",
    "previous": "~/.local/opt/pi/previous",
    "global_append_policy": "~/.pi/agent/APPEND_SYSTEM.md",
    "project_gauntlet_adapter": ".pi/extensions/gauntlet"
  },
  "prohibited_targets": {
    "rtk_automatic_rewrite_extension": "~/.pi/agent/extensions/rtk.ts"
  },
  "install_policy": "official-standalone-linux-arm64-via-pi-scoped-glibc-loader",
  "update_policy": "verified-transactional-core-update",
  "automatic_update": false,
  "global_npm_install": false,
  "project_adapter_policy": "trusted-defense-in-depth-no-sandbox",
  "continuity_protocol": "session-continuity-v1",
  "verification_authority": false
}
