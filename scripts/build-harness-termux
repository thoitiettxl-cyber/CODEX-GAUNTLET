#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SOURCE_REPOSITORY="https://github.com/hoangnb24/repository-harness.git"
SOURCE_TAG="harness-v0.1.7"
SOURCE_COMMIT="d43b70254308b0e10efed2efbcbe595f1e771f63"

if [[ "${CODEX_GAUNTLET_MAINTENANCE:-}" != "1" ]]; then
  echo "FAIL: set CODEX_GAUNTLET_MAINTENANCE=1 after reviewing the pinned source identity." >&2
  exit 2
fi

if [[ "$(uname -o 2>/dev/null || true)" != "Android" ]] ||
   [[ "$(uname -m)" != "aarch64" ]]; then
  echo "FAIL: this build lane requires Termux on Android aarch64." >&2
  exit 2
fi

for command in git cargo rustc cmp install sha256sum; do
  command -v "$command" >/dev/null ||
    { echo "FAIL: missing required command: $command" >&2; exit 2; }
done

BUILD_ROOT="$(mktemp -d)"
cleanup() {
  rm -rf -- "$BUILD_ROOT"
}
trap cleanup EXIT

git clone --filter=blob:none --no-checkout "$SOURCE_REPOSITORY" "$BUILD_ROOT/source"
git -C "$BUILD_ROOT/source" checkout --detach "$SOURCE_TAG"
ACTUAL_COMMIT="$(git -C "$BUILD_ROOT/source" rev-parse HEAD)"
if [[ "$ACTUAL_COMMIT" != "$SOURCE_COMMIT" ]]; then
  echo "FAIL: $SOURCE_TAG resolved to unexpected commit $ACTUAL_COMMIT" >&2
  exit 1
fi

git -C "$BUILD_ROOT/source" apply --check \
  "$ROOT/scripts/patches/harness-cli-android-exclusive-lock.patch"
git -C "$BUILD_ROOT/source" apply \
  "$ROOT/scripts/patches/harness-cli-android-exclusive-lock.patch"

cargo test --locked --manifest-path "$BUILD_ROOT/source/Cargo.toml" \
  --package harness-cli
cargo build --locked --release --manifest-path "$BUILD_ROOT/source/Cargo.toml" \
  --workspace

cmp "$ROOT/scripts/harness-cli-install-files.txt" \
  "$BUILD_ROOT/source/scripts/harness-cli-install-files.txt" ||
  { echo "FAIL: pinned CLI payload manifest differs from upstream." >&2; exit 1; }

install -m 755 "$BUILD_ROOT/source/target/release/harness" \
  "$ROOT/scripts/bin/harness"
install -m 755 "$BUILD_ROOT/source/target/release/harness-cli" \
  "$ROOT/scripts/bin/harness-cli"
install -d "$ROOT/scripts/schema"
install -m 644 "$BUILD_ROOT/source"/scripts/schema/*.sql "$ROOT/scripts/schema/"
while IFS= read -r payload_path; do
  [[ -n "$payload_path" && "$payload_path" != \#* ]] || continue
  [[ "$payload_path" != /* && "$payload_path" != *".."* ]] ||
    { echo "FAIL: unsafe CLI payload path: $payload_path" >&2; exit 1; }
  payload_mode=644
  [[ "$payload_path" == "scripts/bootstrap-harness.sh" ]] && payload_mode=755
  install -D -m "$payload_mode" "$BUILD_ROOT/source/$payload_path" \
    "$ROOT/$payload_path"
done < "$ROOT/scripts/harness-cli-install-files.txt"

"$ROOT/scripts/bin/harness" --version
"$ROOT/scripts/bin/harness-cli" --version
sha256sum "$ROOT/scripts/bin/harness" "$ROOT/scripts/bin/harness-cli"

echo "PASS: built Harness tools from $SOURCE_TAG ($SOURCE_COMMIT)"
