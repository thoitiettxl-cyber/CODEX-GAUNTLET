{
  "schema_version": 1,
  "name": "rtk",
  "kind": "optional-external-binary",
  "capability": "command-output-filtering",
  "responsibility": "Tool access",
  "authority": "orientation-only",
  "control_entrypoint": "scripts/termux-control rtk",
  "provenance": "docs/provenance/rtk-termux-build.json",
  "runbook": "docs/runbooks/rtk-maintenance.md",
  "templates": {
    "config": "config/rtk/config.toml",
    "codex_policy": "config/rtk/RTK.md"
  },
  "materialized_targets": {
    "binary": "~/.local/bin/rtk",
    "config": "~/.config/rtk/config.toml",
    "codex_policy": "~/.codex/RTK.md",
    "codex_entrypoint": "~/.codex/AGENTS.md"
  },
  "update_policy": "reviewed-pinned-native-build-only",
  "automatic_update": false,
  "automatic_rewrite": false,
  "telemetry_consent": false,
  "verification_authority": false
}
