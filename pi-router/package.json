{
  "name": "pi-router",
  "version": "0.5.0",
  "private": true,
  "description": "OpenAI and Anthropic protocol gateway backed by Pi providers",
  "type": "module",
  "bin": {
    "pi-router": "src/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "npm run typecheck:web && npm run build:web && node src/check.js",
    "build:binary": "npm run build && node scripts/build-binary.js",
    "build:web": "node scripts/build-web.js",
    "check": "npm run typecheck:web && npm run check:web && npm run check:binary && node src/check.js",
    "check:binary": "node scripts/check-binary.js",
    "check:web": "node scripts/build-web.js --check",
    "start": "node src/cli.js serve",
    "test": "node test/runner.js all",
    "test:unit": "node test/runner.js unit",
    "test:integration": "node test/runner.js integration",
    "test:acceptance": "node test/runner.js acceptance",
    "test:mutation": "node test/runner.js mutation",
    "test:coverage": "node test/coverage.js",
    "test:binary": "node scripts/test-binary.js",
    "test:live:agentrouter": "node scripts/live-agentrouter.js",
    "typecheck:web": "node node_modules/typescript/bin/tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/merge": "6.12.2",
    "@codemirror/view": "6.43.6",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@uiw/react-codemirror": "4.25.11",
    "axios": "1.18.1",
    "i18next": "26.3.6",
    "motion": "12.42.2",
    "react-i18next": "17.0.9",
    "react-router-dom": "7.18.1",
    "undici": "8.5.0",
    "yaml": "2.9.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "esbuild": "0.28.1",
    "postject": "1.0.0-alpha.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sass": "1.101.0",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vite-plugin-singlefile": "2.3.3"
  }
}
