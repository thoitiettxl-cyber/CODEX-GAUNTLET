{
  "description": "Codex Gauntlet v6 native Windows policy and verification hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/hooks/pre_tool_use_policy.py",
            "commandWindows": "python .codex/hooks/pre_tool_use_policy.py",
            "timeout": 30,
            "statusMessage": "Checking repository policy"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/hooks/permission_request_policy.py",
            "commandWindows": "python .codex/hooks/permission_request_policy.py",
            "timeout": 30,
            "statusMessage": "Checking escalation policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/hooks/post_tool_use_feedback.py",
            "commandWindows": "python .codex/hooks/post_tool_use_feedback.py",
            "timeout": 30,
            "statusMessage": "Reviewing local side effects"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/continuity_cli.py hook",
            "commandWindows": "python scripts/continuity_cli.py hook",
            "timeout": 2,
            "statusMessage": "Restoring session continuity"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/continuity_cli.py hook",
            "commandWindows": "python scripts/continuity_cli.py hook",
            "timeout": 3,
            "statusMessage": "Saving continuity checkpoint"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/continuity_cli.py hook",
            "commandWindows": "python scripts/continuity_cli.py hook",
            "timeout": 2,
            "statusMessage": "Rehydrating continuity checkpoint"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/continuity_cli.py hook",
            "commandWindows": "python scripts/continuity_cli.py hook",
            "timeout": 2,
            "statusMessage": "Recording continuity event"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/hooks/stop_gate.py",
            "commandWindows": "python .codex/hooks/stop_gate.py",
            "timeout": 900,
            "statusMessage": "Running canonical verification"
          }
        ]
      }
    ]
  }
}
