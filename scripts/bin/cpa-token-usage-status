#!/bin/sh
# Safe status report for Magisk CLIProxyAPI + codex-token-usage.
# Never prints secrets.
set -eu
BASE="http://127.0.0.1:8317"
KEY="${CLIPROXYAPI_API_KEY:-}"
OFFLINE_AUTH="${HOME:-/data/data/com.termux/files/home}/.cli-proxy-api"

echo "== CLIProxyAPI module =="
if command -v su >/dev/null 2>&1; then
  su -c '/system/bin/cpactl status' 2>/dev/null || su -c 'cpactl status' 2>/dev/null || echo "cpactl status failed"
else
  echo "su unavailable; cannot read module status"
fi

echo
echo "== Listener =="
curl -sS -o /dev/null -w 'GET /v1/models (no auth) -> %{http_code}\n' --connect-timeout 2 "$BASE/v1/models" 2>/dev/null || echo "listener check failed"

echo
echo "== Plugin directory (names only, root) =="
if command -v su >/dev/null 2>&1; then
  su -c 'ls -la /data/local/cli-proxy-api/plugins/linux/arm64 2>/dev/null || ls -la /data/local/cli-proxy-api/plugins 2>/dev/null || echo plugins missing' 2>/dev/null || true
else
  echo "su unavailable"
fi

echo
echo "== Auth file names (module, names/sizes only) =="
if command -v su >/dev/null 2>&1; then
  su -c 'ls -la /data/local/cli-proxy-api/auth 2>/dev/null || echo auth-dir missing' 2>/dev/null || true
else
  echo "su unavailable"
fi

echo
echo "== Offline auth backup names only (~/.cli-proxy-api) =="
if [ -d "$OFFLINE_AUTH" ]; then
  ls -la "$OFFLINE_AUTH"
else
  echo "offline auth backup missing"
fi

echo
echo "== HTTP checks =="
if [ -z "$KEY" ]; then
  echo "CLIPROXYAPI_API_KEY not set; skip authenticated checks"
  exit 0
fi
for path in /v1/models /v0/resource/plugins/codex-token-usage/dashboard; do
  code=$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $KEY" "$BASE$path" || echo err)
  echo "$path -> $code"
done
