{
  "description": "Codex Gauntlet v3 repository policy and verification hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/data/data/com.termux/files/usr/bin/python3 .codex/hooks/pre_tool_use_policy.py",
            "timeout": 30,
            "statusMessage": "Checking repository policy"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/data/data/com.termux/files/usr/bin/python3 .codex/hooks/permission_request_policy.py",
            "timeout": 30,
            "statusMessage": "Checking escalation policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/data/data/com.termux/files/usr/bin/python3 .codex/hooks/post_tool_use_feedback.py",
            "timeout": 30,
            "statusMessage": "Reviewing local side effects"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/data/data/com.termux/files/usr/bin/python3 .codex/hooks/stop_gate.py",
            "timeout": 900,
            "statusMessage": "Running canonical verification"
          }
        ]
      }
    ]
  }
}
